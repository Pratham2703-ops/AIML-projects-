    },
    index=["Alice", "Bob", "Carol", "Dave", "Eve"],
)


class CollaborativeRecommender:
    def __init__(self, ratings: pd.DataFrame):
        self.ratings = ratings
        self.user_similarity = pd.DataFrame(
            cosine_similarity(ratings),
            index=ratings.index,
            columns=ratings.index,
        )

    def recommend(self, user: str, top_n: int = 3):
        if user not in self.ratings.index:
            raise ValueError(f"Unknown user '{user}'. Known users: {list(self.ratings.index)}")

        
        sims = self.user_similarity[user].drop(user)
        weighted_scores = self.ratings.drop(index=user).T.dot(sims) / sims.sum()

        
        unrated = self.ratings.loc[user] == 0
        weighted_scores = weighted_scores[unrated].sort_values(ascending=False)

        return [
            {"title": title, "predicted_score": round(float(score), 2)}
            for title, score in weighted_scores.head(top_n).items()
        ]



