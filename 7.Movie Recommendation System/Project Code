df = pd.DataFrame(MOVIES)
df["combined_features"] = df["genres"] + " " + df["overview"]



class ContentBasedRecommender:
    def __init__(self, dataframe: pd.DataFrame):
        self.df = dataframe.reset_index(drop=True)
        self.vectorizer = TfidfVectorizer(stop_words="english")
        self.tfidf_matrix = self.vectorizer.fit_transform(self.df["combined_features"])
        self.similarity_matrix = cosine_similarity(self.tfidf_matrix)
        self.title_to_index = {
            title.lower(): idx for idx, title in enumerate(self.df["title"])
        }

    def recommend(self, title: str, top_n: int = 5):
        key = title.lower()
        if key not in self.title_to_index:
            close_matches = [t for t in self.df["title"] if key in t.lower()]
            if close_matches:
                raise ValueError(
                    f"'{title}' not found. Did you mean: {', '.join(close_matches)}?"
                )
            raise ValueError(f"'{title}' not found in catalog.")

        idx = self.title_to_index[key]
        scores = list(enumerate(self.similarity_matrix[idx]))
        scores = sorted(scores, key=lambda x: x[1], reverse=True)
        scores = [s for s in scores if s[0] != idx][:top_n]  # exclude the movie itself

        return [
            {"title": self.df.iloc[i]["title"], "similarity": round(float(score), 3)}
            for i, score in scores
        ]



RATINGS = pd.DataFrame(
    {
