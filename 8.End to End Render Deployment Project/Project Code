def deploy_ngrok():
    from pyngrok import ngrok
    if NGROK_TOKEN:
        ngrok.set_auth_token(NGROK_TOKEN)
    ngrok.kill()
    time.sleep(1)
    url = ngrok.connect(PORT, "http")
    print("")
    print("=" * 60)
    print("PUBLIC URL:", url)
    print("=" * 60)
    print("")
    cmd = "streamlit run /content/app.py --server.port " + str(PORT) + " --server.address 0.0.0.0 --browser.gatherUsageStats false"
    os.system(cmd)

def deploy_colab():
    from google.colab import output
    cmd = "streamlit run /content/app.py --server.port " + str(PORT) + " --server.address 0.0.0.0 --browser.gatherUsageStats false &"
    os.system(cmd)
    time.sleep(5)
    url = output.eval_js("google.colab.kernel.proxyPort(" + str(PORT) + ")")
    print("")
    print("=" * 60)
    print("COLAB URL:", url)
    print("=" * 60)
    print("(Session-only link)")
    while True:
        time.sleep(60)

print("")
print("=" * 60)
print("DEPLOYING...")
print("=" * 60)

if TUNNEL == "ngrok":
    if not NGROK_TOKEN:
        print("")
        print("WARNING: No ngrok token! Get one free at: https://dashboard.ngrok.com")
        print("Or change TUNNEL = 'colab' for native proxy")
        print("")
    deploy_ngrok()
else
    deploy_colab()

