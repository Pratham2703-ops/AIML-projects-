# Step 2: Imports
import os
import numpy as np
import matplotlib.pyplot as plt
import gymnasium as gym
from stable_baselines3 import DQN
from stable_baselines3.common.callbacks import BaseCallback
from stable_baselines3.common.monitor import Monitor
from stable_baselines3.common.vec_env import DummyVecEnv
from stable_baselines3.common.evaluation import evaluate_policy
import torch

# Step 3: Config
CONFIG = {
    "env_name": "LunarLander-v3",
    "total_timesteps": 300_000,
    "eval_freq": 10_000,
    "save_path": "./lunar_model",
}
os.makedirs(CONFIG["save_path"], exist_ok=True)
device = "cuda" if torch.cuda.is_available() else "cpu"
print(f"Device: {device}")

# Step 4: Callback
class MonitorCallback(BaseCallback):
    def __init__(self, eval_env, eval_freq=10000):
        super().__init__()
        self.eval_env = eval_env
        self.eval_freq = eval_freq
        self.best_reward = -np.inf
        self.history = {"steps": [], "rewards": []}
    
    def _on_step(self):
        if self.num_timesteps % self.eval_freq == 0 and self.num_timesteps > 0:
            mean_reward, _ = evaluate_policy(self.model, self.eval_env, n_eval_episodes=5, deterministic=True)
            self.history["steps"].append(self.num_timesteps)
            self.history["rewards"].append(mean_reward)
            print(f"Step {self.num_timesteps:,} | Eval Reward: {mean_reward:.1f}")
            if mean_reward > self.best_reward:
                self.best_reward = mean_reward
                self.model.save(f"{CONFIG['save_path']}/best")
        return True

# Step 5: Create envs
train_env = DummyVecEnv([lambda: Monitor(gym.make(CONFIG["env_name"]))])
eval_env = DummyVecEnv([lambda: Monitor(gym.make(CONFIG["env_name"]))])

# Step 6: Create & train model
model = DQN("MlpPolicy", train_env, 
            learning_rate=1e-3, 
            buffer_size=100000,
            batch_size=128,
            gamma=0.99,
            exploration_fraction=0.3,
            exploration_final_eps=0.05,
            tensorboard_log="./logs",
            verbose=0,
            device=device)

print("Training started...")
callback = MonitorCallback(eval_env, eval_freq=CONFIG["eval_freq"])
model.learn(total_timesteps=CONFIG["total_timesteps"], callback=callback, progress_bar=True)
model.save(f"{CONFIG['save_path']}/final")
print("Training complete!")

# Step 7: Plot results
plt.figure(figsize=(10, 5))
plt.plot(callback.history["steps"], callback.history["rewards"], 'b-o', linewidth=2)
plt.axhline(y=200, color='g', linestyle='--', label='Success (200)')
plt.axhline(y=0, color='r', linestyle='--', label='Crash (0)')
plt.xlabel('Training Steps')
plt.ylabel('Mean Eval Reward')
plt.title('Lunar Lander Training Progress')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# Step 8: Final evaluation
print("\n" + "="*50)
print("FINAL EVALUATION (10 episodes)")
print("="*50)
env = gym.make(CONFIG["env_name"])
rewards = []
for ep in range(10):
    obs, _ = env.reset(seed=ep)
    total = 0
    done = False
    while not done:
        action, _ = model.predict(obs, deterministic=True)
        obs, reward, terminated, truncated, _ = env.step(action)
        total += reward
        done = terminated or truncated
    rewards.append(total)
    status = "LANDED!" if total > 200 else "CRASHED" if total < 0 else "OK"
    print(f"Ep {ep+1}: {total:+.2f} [{status}]")

print(f"\nMean: {np.mean(rewards):.2f} | Best: {np.max(rewards):.2f}")
env.close()
